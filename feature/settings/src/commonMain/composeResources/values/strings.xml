    <string name="settings_share_data">Share workout data with AI engines</string>
    <string name="settings_share_data_description">Lets the AI planners see your recent weights and suggest a working weight. Off by default.</string>
    <string name="settings_guided_workout">Enable guided workouts</string>
    <string name="settings_guided_workout_description">Follow an active scheduled workout one set at a time. Off by default; manual logging stays available.</string>
    <string name="settings_rest_default_section">Default rest duration</string>
    <string name="settings_rest_default_description">Used when an exercise has no saved rest override. Goal-based ranges are guidance only.</string>
    <string name="settings_rest_default_seconds">Seconds (1–86400)</string>
    <string name="settings_rest_default_save">Save default</string>
    <string name="settings_rest_alerts">Background rest alerts</string>
    <string name="settings_rest_alerts_description">Optional local notifications for live guided rest prompts. Precise timing uses Android’s Alarms &amp; reminders access. Power restrictions can still delay alerts; pop-up banners depend on notification settings. This is not a recovery measurement.</string>
    <string name="settings_rest_alerts_late">Alerts may arrive late. Allow precise timing to reduce scheduling delays; alerts remain enabled without it.</string>
    <string name="settings_rest_alerts_precise_action">Allow precise timing</string>
    <string name="settings_rest_alerts_denied">Notifications are blocked. The rest countdown still works; allow notifications in system settings to enable alerts.</string>
    <string name="settings_rest_alerts_unsupported">Background rest alerts are currently available on Android only.</string>
    <string name="settings_short_rest_coaching">Short-rest guidance</string>
    <string name="settings_short_rest_coaching_description">Optional guidance after two consecutive live same-exercise intervals shorter than your chosen rest time. It never changes your workout.</string>
    <string name="settings_rest_countdown">Rest countdown notification</string>
    <string name="settings_rest_countdown_description">Shows the time left in a silent ongoing notification while a rest countdown runs, so you can check it without opening HydraFit. Off by default.</string>
    <string name="settings_rest_countdown_denied">Notifications are blocked. Allow notifications in system settings to show the rest countdown notification.</string>
    <string name="settings_rest_completion">Rest complete signal</string>
    <string name="settings_rest_completion_description">Shows a brief “Rest complete” message and one short vibration when a rest countdown ends while HydraFit is open. Off by default.</string>
    <string name="settings_reminders_section">Workout reminders</string>
    <string name="settings_reminders_enable">Remind me about planned workouts</string>
    <string name="settings_reminders_description">One notification on days when your active block has a workout planned, at a local time you choose. It never starts or logs a workout, and delivery may be late.</string>
