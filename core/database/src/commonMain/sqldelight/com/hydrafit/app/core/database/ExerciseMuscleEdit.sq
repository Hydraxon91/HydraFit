CREATE TABLE exerciseMuscleEdit (
    exerciseId TEXT NOT NULL PRIMARY KEY,
    primaryMuscles TEXT NOT NULL,
    secondaryMuscles TEXT NOT NULL
);

selectAll:
SELECT * FROM exerciseMuscleEdit;

selectById:
SELECT * FROM exerciseMuscleEdit WHERE exerciseId = ?;

upsert:
INSERT OR REPLACE INTO exerciseMuscleEdit(exerciseId, primaryMuscles, secondaryMuscles)
VALUES (?, ?, ?);

deleteById:
DELETE FROM exerciseMuscleEdit WHERE exerciseId = ?;
