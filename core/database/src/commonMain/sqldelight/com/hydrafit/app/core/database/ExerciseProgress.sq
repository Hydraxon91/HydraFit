-- Paging splits the first page from each cursor continuation so the cursor never
-- appears as an optional `OR` predicate: SQLite can then always seek the
-- (exerciseId, performedAt, id) index directly instead of rescanning what earlier
-- pages already read. Continuations use disjoint bounds -- an equal-timestamp/id
-- range plus a strictly earlier/later-time range -- that the repository concatenates.
selectExerciseHistoryFirstPage:
SELECT workoutSet.id, workoutSet.exerciseId,
       COALESCE(exerciseOverride.name, exercise.name) AS exerciseName,
       workoutSet.reps, workoutSet.weightKg, workoutSet.loadKind, workoutSet.isWarmup,
       workoutSet.rir, workoutSet.performedAt, workoutSet.timingProvenance, workoutSet.occurrenceId
FROM workoutSet
LEFT JOIN exercise ON exercise.id = workoutSet.exerciseId
LEFT JOIN exerciseOverride ON exerciseOverride.exerciseId = workoutSet.exerciseId
WHERE workoutSet.exerciseId = :exerciseId
ORDER BY workoutSet.performedAt DESC, workoutSet.id DESC
LIMIT :pageLimit;

selectExerciseHistoryTiesAtCursor:
SELECT workoutSet.id, workoutSet.exerciseId,
       COALESCE(exerciseOverride.name, exercise.name) AS exerciseName,
       workoutSet.reps, workoutSet.weightKg, workoutSet.loadKind, workoutSet.isWarmup,
       workoutSet.rir, workoutSet.performedAt, workoutSet.timingProvenance, workoutSet.occurrenceId
FROM workoutSet
LEFT JOIN exercise ON exercise.id = workoutSet.exerciseId
LEFT JOIN exerciseOverride ON exerciseOverride.exerciseId = workoutSet.exerciseId
WHERE workoutSet.exerciseId = :exerciseId
  AND workoutSet.performedAt = :cursorTime
  AND workoutSet.id < :cursorId
ORDER BY workoutSet.performedAt DESC, workoutSet.id DESC
LIMIT :pageLimit;

selectExerciseHistoryBeforeCursorTime:
SELECT workoutSet.id, workoutSet.exerciseId,
       COALESCE(exerciseOverride.name, exercise.name) AS exerciseName,
       workoutSet.reps, workoutSet.weightKg, workoutSet.loadKind, workoutSet.isWarmup,
       workoutSet.rir, workoutSet.performedAt, workoutSet.timingProvenance, workoutSet.occurrenceId
FROM workoutSet
LEFT JOIN exercise ON exercise.id = workoutSet.exerciseId
LEFT JOIN exerciseOverride ON exerciseOverride.exerciseId = workoutSet.exerciseId
WHERE workoutSet.exerciseId = :exerciseId
  AND workoutSet.performedAt < :cursorTime
ORDER BY workoutSet.performedAt DESC, workoutSet.id DESC
LIMIT :pageLimit;

-- Invalidation anchor, not a revision number. Updates with unchanged counts must still replay.
observeExerciseSets:
SELECT count(*) FROM workoutSet WHERE exerciseId = :exerciseId;

selectExerciseReplayFirstPage:
SELECT id, exerciseId, reps, weightKg, loadKind, performedAt, isWarmup, occurrenceId
FROM workoutSet
WHERE exerciseId = :exerciseId AND performedAt <= :nowMillis
ORDER BY performedAt ASC, id ASC
LIMIT :pageLimit;

selectExerciseReplayTiesAtCursor:
SELECT id, exerciseId, reps, weightKg, loadKind, performedAt, isWarmup, occurrenceId
FROM workoutSet
WHERE exerciseId = :exerciseId AND performedAt <= :nowMillis
  AND performedAt = :cursorTime
  AND id > :cursorId
ORDER BY performedAt ASC, id ASC
LIMIT :pageLimit;

selectExerciseReplayAfterCursorTime:
SELECT id, exerciseId, reps, weightKg, loadKind, performedAt, isWarmup, occurrenceId
FROM workoutSet
WHERE exerciseId = :exerciseId AND performedAt <= :nowMillis
  AND performedAt > :cursorTime
ORDER BY performedAt ASC, id ASC
LIMIT :pageLimit;
