-- Paging splits the first page from each cursor continuation so the cursor never
-- appears as an optional `OR` predicate: SQLite can then always seek the
-- (exerciseId, performedAt, id) index directly instead of rescanning what earlier
-- pages already read. Continuations use disjoint bounds -- an equal-timestamp/id
-- range plus a strictly earlier/later-time range -- that the repository concatenates.
selectExerciseHistoryFirstPage:
SELECT workoutSet.id, workoutSet.exerciseId,
       COALESCE(exerciseOverride.name, exercise.name) AS exerciseName,
       workoutSet.reps, workoutSet.weightKg, workoutSet.loadKind, workoutSet.isWarmup,
       workoutSet.rir, workoutSet.performedAt, workoutSet.timingProvenance, workoutSet.occurrenceId,
       workoutSet.durationSeconds, workoutSet.stationId, workoutSet.stationName,
        workoutSet.stationLoadBasis, workoutSet.distanceMeters, workoutSet.forceNewtons, workoutSet.deviceName, workoutSet.deviceRatingKg,
        workoutSet.clusterKind, workoutSet.clusterPlannedSegments, workoutSet.clusterPerformedSegments
FROM workoutSet
LEFT JOIN exercise ON exercise.id = workoutSet.exerciseId
LEFT JOIN exerciseOverride ON exerciseOverride.exerciseId = workoutSet.exerciseId
WHERE workoutSet.exerciseId = :exerciseId
ORDER BY workoutSet.performedAt DESC, workoutSet.id DESC
LIMIT :pageLimit;

selectExerciseHistoryTiesAtCursor:
SELECT workoutSet.id, workoutSet.exerciseId,
       COALESCE(exerciseOverride.name, exercise.name) AS exerciseName,
       workoutSet.reps, workoutSet.weightKg, workoutSet.loadKind, workoutSet.isWarmup,
       workoutSet.rir, workoutSet.performedAt, workoutSet.timingProvenance, workoutSet.occurrenceId,
       workoutSet.durationSeconds, workoutSet.stationId, workoutSet.stationName,
        workoutSet.stationLoadBasis, workoutSet.distanceMeters, workoutSet.forceNewtons, workoutSet.deviceName, workoutSet.deviceRatingKg,
        workoutSet.clusterKind, workoutSet.clusterPlannedSegments, workoutSet.clusterPerformedSegments
FROM workoutSet
LEFT JOIN exercise ON exercise.id = workoutSet.exerciseId
LEFT JOIN exerciseOverride ON exerciseOverride.exerciseId = workoutSet.exerciseId
WHERE workoutSet.exerciseId = :exerciseId
  AND workoutSet.performedAt = :cursorTime
  AND workoutSet.id < :cursorId
ORDER BY workoutSet.performedAt DESC, workoutSet.id DESC
LIMIT :pageLimit;

selectExerciseHistoryBeforeCursorTime:
SELECT workoutSet.id, workoutSet.exerciseId,
       COALESCE(exerciseOverride.name, exercise.name) AS exerciseName,
       workoutSet.reps, workoutSet.weightKg, workoutSet.loadKind, workoutSet.isWarmup,
       workoutSet.rir, workoutSet.performedAt, workoutSet.timingProvenance, workoutSet.occurrenceId,
       workoutSet.durationSeconds, workoutSet.stationId, workoutSet.stationName,
        workoutSet.stationLoadBasis, workoutSet.distanceMeters, workoutSet.forceNewtons, workoutSet.deviceName, workoutSet.deviceRatingKg,
        workoutSet.clusterKind, workoutSet.clusterPlannedSegments, workoutSet.clusterPerformedSegments
FROM workoutSet
LEFT JOIN exercise ON exercise.id = workoutSet.exerciseId
LEFT JOIN exerciseOverride ON exerciseOverride.exerciseId = workoutSet.exerciseId
WHERE workoutSet.exerciseId = :exerciseId
  AND workoutSet.performedAt < :cursorTime
ORDER BY workoutSet.performedAt DESC, workoutSet.id DESC
LIMIT :pageLimit;

-- One contributing set by its exercise-scoped id. Bounded by exerciseId and id so a record holder
-- can be shown without reading the exercise's whole history; no sessionId-is-null restriction.
selectExerciseSetById:
SELECT workoutSet.id, workoutSet.exerciseId,
       COALESCE(exerciseOverride.name, exercise.name) AS exerciseName,
       workoutSet.reps, workoutSet.weightKg, workoutSet.loadKind, workoutSet.isWarmup,
       workoutSet.rir, workoutSet.performedAt, workoutSet.timingProvenance, workoutSet.occurrenceId,
       workoutSet.durationSeconds, workoutSet.stationId, workoutSet.stationName,
        workoutSet.stationLoadBasis, workoutSet.distanceMeters, workoutSet.forceNewtons, workoutSet.deviceName, workoutSet.deviceRatingKg,
        workoutSet.clusterKind, workoutSet.clusterPlannedSegments, workoutSet.clusterPerformedSegments
FROM workoutSet
LEFT JOIN exercise ON exercise.id = workoutSet.exerciseId
LEFT JOIN exerciseOverride ON exerciseOverride.exerciseId = workoutSet.exerciseId
WHERE workoutSet.exerciseId = :exerciseId
  AND workoutSet.id = :setId;

-- Invalidation anchor, not a revision number. Updates with unchanged counts must still replay.
observeExerciseSets:
SELECT count(*) FROM workoutSet WHERE exerciseId = :exerciseId;

-- Complete station filter source for one exercise, independent of the loaded history page.
selectStationOptions:
SELECT DISTINCT stationId, stationName, stationLoadBasis
FROM workoutSet
WHERE exerciseId = :exerciseId
  AND stationId IS NOT NULL
  AND stationId > 0
  AND stationName IS NOT NULL
  AND stationLoadBasis IS NOT NULL
ORDER BY stationName;

selectExerciseReplayFirstPage:
SELECT id, exerciseId, reps, weightKg, loadKind, performedAt, isWarmup, occurrenceId, durationSeconds,
        stationId, stationName, stationLoadBasis, distanceMeters, forceNewtons, deviceName, deviceRatingKg,
        clusterKind, clusterPlannedSegments, clusterPerformedSegments
FROM workoutSet
WHERE exerciseId = :exerciseId AND performedAt <= :nowMillis
ORDER BY performedAt ASC, id ASC
LIMIT :pageLimit;

selectExerciseReplayTiesAtCursor:
SELECT id, exerciseId, reps, weightKg, loadKind, performedAt, isWarmup, occurrenceId, durationSeconds,
        stationId, stationName, stationLoadBasis, distanceMeters, forceNewtons, deviceName, deviceRatingKg,
        clusterKind, clusterPlannedSegments, clusterPerformedSegments
FROM workoutSet
WHERE exerciseId = :exerciseId AND performedAt <= :nowMillis
  AND performedAt = :cursorTime
  AND id > :cursorId
ORDER BY performedAt ASC, id ASC
LIMIT :pageLimit;

selectExerciseReplayAfterCursorTime:
SELECT id, exerciseId, reps, weightKg, loadKind, performedAt, isWarmup, occurrenceId, durationSeconds,
        stationId, stationName, stationLoadBasis, distanceMeters, forceNewtons, deviceName, deviceRatingKg,
        clusterKind, clusterPlannedSegments, clusterPerformedSegments
FROM workoutSet
WHERE exerciseId = :exerciseId AND performedAt <= :nowMillis
  AND performedAt > :cursorTime
ORDER BY performedAt ASC, id ASC
LIMIT :pageLimit;

-- The distinct exercises recorded against one occurrence, in a stable id order. Scoped to the
-- occurrence so a summary's record read never scans the whole log: the (occurrenceId, exerciseId)
-- index seeks one occurrence and supplies the DISTINCT/ORDER BY order directly. The live query
-- emits on every workoutSet write.
observeOccurrenceExerciseIds:
SELECT DISTINCT exerciseId FROM workoutSet WHERE occurrenceId = :occurrenceId ORDER BY exerciseId;
