CREATE TABLE workoutSession (
    id TEXT NOT NULL PRIMARY KEY,
    startedAtMillis INTEGER NOT NULL,
    endedAtMillis INTEGER,
    localEpochDay INTEGER NOT NULL,
    occurrenceId INTEGER
);

insertSession:
INSERT INTO workoutSession(id, startedAtMillis, endedAtMillis, localEpochDay)
VALUES (?, ?, ?, ?);

-- Restore path only: preserves the exported occurrence link in one insert.
insertSessionWithOccurrence:
INSERT INTO workoutSession(id, startedAtMillis, endedAtMillis, localEpochDay, occurrenceId)
VALUES (?, ?, ?, ?, ?);

deleteAllSessions:
DELETE FROM workoutSession;

assignOccurrence:
UPDATE workoutSession SET occurrenceId = ? WHERE id = ?;

endSession:
UPDATE workoutSession SET endedAtMillis = ? WHERE id = ?;

updateSessionBounds:
UPDATE workoutSession
SET startedAtMillis = ?, endedAtMillis = ?, localEpochDay = ?
WHERE id = ?;

selectOpenSession:
SELECT * FROM workoutSession WHERE endedAtMillis IS NULL ORDER BY startedAtMillis DESC LIMIT 1;

selectAllSessions:
SELECT * FROM workoutSession ORDER BY startedAtMillis, id;
