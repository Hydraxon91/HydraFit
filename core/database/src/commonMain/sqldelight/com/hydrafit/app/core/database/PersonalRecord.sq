CREATE TABLE personalRecord (
    exerciseId TEXT NOT NULL PRIMARY KEY,
    weightKg REAL NOT NULL,
    reps INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    loadKind TEXT NOT NULL DEFAULT 'LEGACY_UNSPECIFIED'
);

selectAll:
SELECT * FROM personalRecord ORDER BY exerciseId;

selectById:
SELECT * FROM personalRecord WHERE exerciseId = ?;

updateExerciseId:
UPDATE personalRecord SET exerciseId = :newId WHERE exerciseId = :oldId;

upsert:
INSERT OR REPLACE INTO personalRecord(exerciseId, weightKg, reps, updatedAt, loadKind)
VALUES (?, ?, ?, ?, ?);

deleteById:
DELETE FROM personalRecord WHERE exerciseId = ?;

deleteAll:
DELETE FROM personalRecord;
