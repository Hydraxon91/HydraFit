CREATE TABLE workoutSet (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    exerciseId TEXT NOT NULL,
    reps INTEGER,
    weightKg REAL,
    performedAt INTEGER NOT NULL,
    isWarmup INTEGER NOT NULL DEFAULT 0,
    involvements TEXT,
    weekNumber INTEGER,
    cycleNumber INTEGER,
    dayIndex INTEGER,
    rir INTEGER,
    sessionId TEXT,
    occurrenceId INTEGER,
    occurrenceEntryId INTEGER,
    loadKind TEXT NOT NULL DEFAULT 'LEGACY_UNSPECIFIED',
    timingProvenance TEXT NOT NULL DEFAULT 'UNKNOWN',
    startedAtElapsedMillis INTEGER,
    completedAtElapsedMillis INTEGER,
    durationSeconds INTEGER,
    prescriptionSnapshot TEXT,
    stationId INTEGER,
    stationName TEXT,
    stationLoadBasis TEXT,
    FOREIGN KEY (exerciseId) REFERENCES exercise(id)
);

insertSet:
INSERT INTO workoutSet(exerciseId, reps, weightKg, performedAt, isWarmup, involvements, weekNumber, cycleNumber, dayIndex, rir, sessionId, loadKind, durationSeconds)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertSetWithTimingProvenance:
INSERT INTO workoutSet(exerciseId, reps, weightKg, performedAt, isWarmup, involvements, weekNumber, cycleNumber, dayIndex, rir, sessionId, loadKind, timingProvenance, startedAtElapsedMillis, completedAtElapsedMillis, durationSeconds, prescriptionSnapshot)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertedSetId:
SELECT last_insert_rowid();

-- Restore path only: preserves the exported row identity and both occurrence links.
insertSetWithId:
INSERT INTO workoutSet(id, exerciseId, reps, weightKg, performedAt, isWarmup, involvements, weekNumber, cycleNumber, dayIndex, rir, sessionId, occurrenceId, occurrenceEntryId, loadKind, durationSeconds)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertSetWithIdAndTimingProvenance:
INSERT INTO workoutSet(id, exerciseId, reps, weightKg, performedAt, isWarmup, involvements, weekNumber, cycleNumber, dayIndex, rir, sessionId, occurrenceId, occurrenceEntryId, loadKind, timingProvenance, startedAtElapsedMillis, completedAtElapsedMillis, durationSeconds, prescriptionSnapshot)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllSets:
SELECT * FROM workoutSet ORDER BY performedAt, id;

selectSetById:
SELECT * FROM workoutSet WHERE id = ?;

updateSetValues:
UPDATE workoutSet SET reps = ?, durationSeconds = ?, weightKg = ?, rir = ? WHERE id = ?;

updateSetValuesAndInvalidateTiming:
UPDATE workoutSet
SET reps = ?, durationSeconds = ?, weightKg = ?, rir = ?, timingProvenance = 'UNKNOWN',
    startedAtElapsedMillis = NULL, completedAtElapsedMillis = NULL
WHERE id = ?;

-- Station attribution is frozen at logging. It is never inferred from today's equipment profile.
assignStation:
UPDATE workoutSet
SET stationId = ?, stationName = ?, stationLoadBasis = ?
WHERE id = ?;

selectLastSetBySession:
SELECT * FROM workoutSet WHERE sessionId = ? ORDER BY performedAt DESC, id DESC LIMIT 1;

assignSession:
UPDATE workoutSet SET sessionId = ? WHERE id = ?;

assignOccurrence:
UPDATE workoutSet SET occurrenceId = ?, occurrenceEntryId = ? WHERE id = ?;

selectSetsForOccurrence:
SELECT * FROM workoutSet WHERE occurrenceId = ? ORDER BY performedAt, id;

selectSetsForOccurrenceEntry:
SELECT * FROM workoutSet WHERE occurrenceEntryId = ? ORDER BY performedAt, id;

updateSetPerformedAt:
UPDATE workoutSet
SET performedAt = ?, timingProvenance = 'UNKNOWN',
    startedAtElapsedMillis = NULL, completedAtElapsedMillis = NULL
WHERE id = ?;

updateSetExerciseId:
UPDATE workoutSet SET exerciseId = :newId WHERE exerciseId = :oldId;

updatePrescriptionSnapshot:
UPDATE workoutSet SET prescriptionSnapshot = ? WHERE id = ?;

selectUnsegmentedSets:
SELECT * FROM workoutSet WHERE sessionId IS NULL ORDER BY performedAt, id;

deleteSet:
DELETE FROM workoutSet WHERE id = ?;

deleteAllSets:
DELETE FROM workoutSet;

-- History reads filter and group by `sessionId` and order one session's sets by `performedAt`.
CREATE INDEX workoutSet_sessionId_performedAt ON workoutSet(sessionId, performedAt);

-- Exercise history and progress replay page by recorded time/id within one exercise.
CREATE INDEX workoutSet_exerciseId_performedAt_id ON workoutSet(exerciseId, performedAt, id);

-- One occurrence's recorded exercises are read live by the summary's record section; a composite
-- occurrence/exercise index seeks that occurrence and satisfies DISTINCT/ORDER BY directly.
CREATE INDEX workoutSet_occurrenceId_exerciseId ON workoutSet(occurrenceId, exerciseId);
