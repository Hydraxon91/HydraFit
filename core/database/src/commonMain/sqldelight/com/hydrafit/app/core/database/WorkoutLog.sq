CREATE TABLE workoutSet (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    exerciseId TEXT NOT NULL,
    reps INTEGER NOT NULL,
    weightKg REAL,
    performedAt INTEGER NOT NULL,
    isWarmup INTEGER NOT NULL DEFAULT 0,
    involvements TEXT,
    weekNumber INTEGER,
    cycleNumber INTEGER,
    dayIndex INTEGER,
    rir INTEGER,
    sessionId TEXT,
    occurrenceId INTEGER,
    occurrenceEntryId INTEGER,
    loadKind TEXT NOT NULL DEFAULT 'LEGACY_UNSPECIFIED',
    FOREIGN KEY (exerciseId) REFERENCES exercise(id)
);

insertSet:
INSERT INTO workoutSet(exerciseId, reps, weightKg, performedAt, isWarmup, involvements, weekNumber, cycleNumber, dayIndex, rir, sessionId, loadKind)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertedSetId:
SELECT last_insert_rowid();

-- Restore path only: preserves the exported row identity and both occurrence links.
insertSetWithId:
INSERT INTO workoutSet(id, exerciseId, reps, weightKg, performedAt, isWarmup, involvements, weekNumber, cycleNumber, dayIndex, rir, sessionId, occurrenceId, occurrenceEntryId, loadKind)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllSets:
SELECT * FROM workoutSet ORDER BY performedAt, id;

selectLastSetBySession:
SELECT * FROM workoutSet WHERE sessionId = ? ORDER BY performedAt DESC, id DESC LIMIT 1;

assignSession:
UPDATE workoutSet SET sessionId = ? WHERE id = ?;

assignOccurrence:
UPDATE workoutSet SET occurrenceId = ?, occurrenceEntryId = ? WHERE id = ?;

selectSetsForOccurrence:
SELECT * FROM workoutSet WHERE occurrenceId = ? ORDER BY performedAt, id;

selectSetsForOccurrenceEntry:
SELECT * FROM workoutSet WHERE occurrenceEntryId = ? ORDER BY performedAt, id;

updateSetPerformedAt:
UPDATE workoutSet SET performedAt = ? WHERE id = ?;

updateSetExerciseId:
UPDATE workoutSet SET exerciseId = :newId WHERE exerciseId = :oldId;

selectUnsegmentedSets:
SELECT * FROM workoutSet WHERE sessionId IS NULL ORDER BY performedAt, id;

deleteSet:
DELETE FROM workoutSet WHERE id = ?;

deleteAllSets:
DELETE FROM workoutSet;
