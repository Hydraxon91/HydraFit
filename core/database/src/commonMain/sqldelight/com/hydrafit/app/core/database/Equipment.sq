CREATE TABLE equipment (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    isBuiltIn INTEGER NOT NULL DEFAULT 0,
    maxWeightKg REAL
);

selectAll:
SELECT * FROM equipment ORDER BY isBuiltIn DESC, name;

insertIgnore:
INSERT OR IGNORE INTO equipment(id, name, isBuiltIn) VALUES (?, ?, ?);

insert:
INSERT INTO equipment(id, name, isBuiltIn) VALUES (?, ?, ?);

updateMaxWeight:
UPDATE equipment SET maxWeightKg = ? WHERE id = ?;

updateNameAndMaxWeight:
UPDATE equipment SET name = ?, maxWeightKg = ? WHERE id = ? AND isBuiltIn = 0;

deleteById:
DELETE FROM equipment WHERE id = ?;

-- Restore path: built-in rows stay (seed-owned); only user-created equipment is replaced.
deleteCustomEquipment:
DELETE FROM equipment WHERE isBuiltIn = 0;
