CREATE TABLE equipment (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    isBuiltIn INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM equipment ORDER BY isBuiltIn DESC, name;

insertIgnore:
INSERT OR IGNORE INTO equipment(id, name, isBuiltIn) VALUES (?, ?, ?);

insert:
INSERT INTO equipment(id, name, isBuiltIn) VALUES (?, ?, ?);

deleteById:
DELETE FROM equipment WHERE id = ?;
