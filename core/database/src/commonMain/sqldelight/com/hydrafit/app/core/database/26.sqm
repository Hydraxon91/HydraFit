CREATE TABLE trainingActivation (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    templateId INTEGER,
    templateRevision INTEGER,
    sourcePlanId INTEGER,
    name TEXT NOT NULL,
    createdAtMillis INTEGER NOT NULL,
    startEpochDay INTEGER NOT NULL,
    mode TEXT NOT NULL,
    weekdayMask INTEGER NOT NULL,
    status TEXT NOT NULL,
    weekNumber INTEGER,
    cycleNumber INTEGER,
    endedAtMillis INTEGER,
    revision INTEGER NOT NULL
);

CREATE TABLE activationWorkout (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    activationId INTEGER NOT NULL,
    sourceWorkoutId INTEGER,
    position INTEGER NOT NULL,
    name TEXT NOT NULL,
    focus TEXT,
    FOREIGN KEY (activationId) REFERENCES trainingActivation(id)
);

CREATE TABLE activationEntry (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    workoutId INTEGER NOT NULL,
    position INTEGER NOT NULL,
    exerciseId TEXT NOT NULL,
    exerciseName TEXT NOT NULL,
    movementPattern TEXT NOT NULL,
    requiredEquipment TEXT NOT NULL,
    involvements TEXT,
    isUnilateral INTEGER NOT NULL DEFAULT 0,
    sets INTEGER NOT NULL,
    reps INTEGER NOT NULL,
    weightKg REAL,
    FOREIGN KEY (workoutId) REFERENCES activationWorkout(id)
);

CREATE TABLE workoutOccurrence (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    activationId INTEGER NOT NULL,
    activationWorkoutId INTEGER NOT NULL,
    queuePosition INTEGER NOT NULL,
    scheduledEpochDay INTEGER,
    notBeforeEpochDay INTEGER,
    startedAtMillis INTEGER,
    resolvedAtMillis INTEGER,
    status TEXT NOT NULL,
    revision INTEGER NOT NULL,
    FOREIGN KEY (activationId) REFERENCES trainingActivation(id)
);

CREATE TABLE occurrenceEntry (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    occurrenceId INTEGER NOT NULL,
    sourceActivationEntryId INTEGER NOT NULL,
    position INTEGER NOT NULL,
    exerciseId TEXT NOT NULL,
    exerciseName TEXT NOT NULL,
    movementPattern TEXT NOT NULL,
    requiredEquipment TEXT NOT NULL,
    involvements TEXT,
    isUnilateral INTEGER NOT NULL DEFAULT 0,
    sets INTEGER NOT NULL,
    reps INTEGER NOT NULL,
    weightKg REAL,
    remainingDisposition TEXT,
    terminalRemainingSets INTEGER,
    FOREIGN KEY (occurrenceId) REFERENCES workoutOccurrence(id)
);

CREATE TABLE workoutScheduleState (
    id INTEGER NOT NULL PRIMARY KEY,
    activeActivationId INTEGER,
    selectedOccurrenceId INTEGER,
    legacyFallbackEnabled INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX activationWorkout_activationId ON activationWorkout(activationId);
CREATE INDEX activationEntry_workoutId ON activationEntry(workoutId);
CREATE INDEX workoutOccurrence_activationId ON workoutOccurrence(activationId);
CREATE INDEX occurrenceEntry_occurrenceId ON occurrenceEntry(occurrenceId);

ALTER TABLE workoutSession ADD COLUMN occurrenceId INTEGER;
ALTER TABLE workoutSet ADD COLUMN occurrenceId INTEGER;
ALTER TABLE workoutSet ADD COLUMN occurrenceEntryId INTEGER;
