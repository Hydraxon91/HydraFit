CREATE TABLE plannerEngine (
    id INTEGER NOT NULL PRIMARY KEY,
    engineId TEXT NOT NULL,
    daysPerWeek INTEGER NOT NULL DEFAULT 4
);

selectEngine:
SELECT engineId FROM plannerEngine WHERE id = 0;

selectDaysPerWeek:
SELECT daysPerWeek FROM plannerEngine WHERE id = 0;

insertIgnoreRow:
INSERT OR IGNORE INTO plannerEngine(id, engineId) VALUES (0, ?);

updateEngine:
UPDATE plannerEngine SET engineId = ? WHERE id = 0;

updateDaysPerWeek:
UPDATE plannerEngine SET daysPerWeek = ? WHERE id = 0;
