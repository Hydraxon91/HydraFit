CREATE TABLE plannerEngine (
    id INTEGER NOT NULL PRIMARY KEY,
    engineId TEXT NOT NULL,
    daysPerWeek INTEGER NOT NULL DEFAULT 4,
    trainingGoal TEXT NOT NULL DEFAULT 'BALANCED',
    shareWorkoutData INTEGER NOT NULL DEFAULT 0,
    weightUnit TEXT NOT NULL DEFAULT 'KG'
);

selectEngine:
SELECT engineId FROM plannerEngine WHERE id = 0;

selectDaysPerWeek:
SELECT daysPerWeek FROM plannerEngine WHERE id = 0;

selectTrainingGoal:
SELECT trainingGoal FROM plannerEngine WHERE id = 0;

selectShareWorkoutData:
SELECT shareWorkoutData FROM plannerEngine WHERE id = 0;

selectWeightUnit:
SELECT weightUnit FROM plannerEngine WHERE id = 0;

insertIgnoreRow:
INSERT OR IGNORE INTO plannerEngine(id, engineId) VALUES (0, ?);

updateEngine:
UPDATE plannerEngine SET engineId = ? WHERE id = 0;

updateDaysPerWeek:
UPDATE plannerEngine SET daysPerWeek = ? WHERE id = 0;

updateTrainingGoal:
UPDATE plannerEngine SET trainingGoal = ? WHERE id = 0;

updateShareWorkoutData:
UPDATE plannerEngine SET shareWorkoutData = ? WHERE id = 0;

updateWeightUnit:
UPDATE plannerEngine SET weightUnit = ? WHERE id = 0;
