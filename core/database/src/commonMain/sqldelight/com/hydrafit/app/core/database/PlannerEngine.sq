CREATE TABLE plannerEngine (
    id INTEGER NOT NULL PRIMARY KEY,
    engineId TEXT NOT NULL,
    daysPerWeek INTEGER NOT NULL DEFAULT 4,
    trainingGoal TEXT NOT NULL DEFAULT 'BALANCED',
    shareWorkoutData INTEGER NOT NULL DEFAULT 0,
    weightUnit TEXT NOT NULL DEFAULT 'KG',
    guidedWorkoutEnabled INTEGER NOT NULL DEFAULT 0,
    distanceUnit TEXT NOT NULL DEFAULT 'METERS',
    setsPerExercise INTEGER,
    accessorySetsPerExercise INTEGER,
    autoTargetShape TEXT,
    autoTargetMinReps INTEGER,
    autoTargetMaxReps INTEGER,
    autoTargetRir INTEGER,
    sessionLength TEXT
);

selectPlanParameters:
SELECT setsPerExercise, accessorySetsPerExercise, autoTargetShape, autoTargetMinReps,
    autoTargetMaxReps, autoTargetRir, sessionLength
FROM plannerEngine WHERE id = 0;

updateSessionLength:
UPDATE plannerEngine SET sessionLength = ? WHERE id = 0;

updateSetsPerExercise:
UPDATE plannerEngine SET setsPerExercise = ? WHERE id = 0;

updateAccessorySetsPerExercise:
UPDATE plannerEngine SET accessorySetsPerExercise = ? WHERE id = 0;

updateAutoTarget:
UPDATE plannerEngine SET autoTargetShape = ?, autoTargetMinReps = ?, autoTargetMaxReps = ?,
    autoTargetRir = ?
WHERE id = 0;

selectEngine:
SELECT engineId FROM plannerEngine WHERE id = 0;

selectDaysPerWeek:
SELECT daysPerWeek FROM plannerEngine WHERE id = 0;

selectTrainingGoal:
SELECT trainingGoal FROM plannerEngine WHERE id = 0;

selectShareWorkoutData:
SELECT shareWorkoutData FROM plannerEngine WHERE id = 0;

selectWeightUnit:
SELECT weightUnit FROM plannerEngine WHERE id = 0;

selectGuidedWorkoutEnabled:
SELECT guidedWorkoutEnabled FROM plannerEngine WHERE id = 0;

selectDistanceUnit:
SELECT distanceUnit FROM plannerEngine WHERE id = 0;

insertIgnoreRow:
INSERT OR IGNORE INTO plannerEngine(id, engineId) VALUES (0, ?);

updateEngine:
UPDATE plannerEngine SET engineId = ? WHERE id = 0;

updateDaysPerWeek:
UPDATE plannerEngine SET daysPerWeek = ? WHERE id = 0;

updateTrainingGoal:
UPDATE plannerEngine SET trainingGoal = ? WHERE id = 0;

updateShareWorkoutData:
UPDATE plannerEngine SET shareWorkoutData = ? WHERE id = 0;

updateWeightUnit:
UPDATE plannerEngine SET weightUnit = ? WHERE id = 0;

updateGuidedWorkoutEnabled:
UPDATE plannerEngine SET guidedWorkoutEnabled = ? WHERE id = 0;

updateDistanceUnit:
UPDATE plannerEngine SET distanceUnit = ? WHERE id = 0;
