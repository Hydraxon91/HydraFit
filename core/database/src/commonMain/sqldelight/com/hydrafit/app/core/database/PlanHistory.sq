CREATE TABLE planHistory (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    engineId TEXT NOT NULL,
    acceptedAt INTEGER NOT NULL,
    weekNumber INTEGER NOT NULL DEFAULT 1,
    cycleNumber INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE planHistoryDay (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    planId INTEGER NOT NULL,
    dayIndex INTEGER NOT NULL,
    focus TEXT NOT NULL,
    FOREIGN KEY (planId) REFERENCES planHistory(id)
);

CREATE TABLE planHistoryEntry (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    dayId INTEGER NOT NULL,
    position INTEGER NOT NULL,
    exerciseId TEXT NOT NULL,
    sets INTEGER NOT NULL,
    reps INTEGER,
    durationSeconds INTEGER,
    exerciseName TEXT NOT NULL,
    movementPattern TEXT NOT NULL,
    suggestedWeightKg REAL,
    loadCapability TEXT NOT NULL DEFAULT 'UNSPECIFIED',
    loadKind TEXT NOT NULL DEFAULT 'LEGACY_UNSPECIFIED',
    progressionPolicy TEXT,
    setTargets TEXT,
    superset TEXT,
    distanceMeters INTEGER,
    forceNewtons REAL,
    FOREIGN KEY (dayId) REFERENCES planHistoryDay(id)
);

insertPlan:
INSERT INTO planHistory(engineId, acceptedAt, weekNumber, cycleNumber) VALUES (?, ?, ?, ?);

-- Restore path only: preserves the exported plan/day/entry identities.
insertPlanWithId:
INSERT INTO planHistory(id, engineId, acceptedAt, weekNumber, cycleNumber) VALUES (?, ?, ?, ?, ?);

insertDayWithId:
INSERT INTO planHistoryDay(id, planId, dayIndex, focus) VALUES (?, ?, ?, ?);

insertEntryWithId:
INSERT INTO planHistoryEntry(id, dayId, position, exerciseId, sets, reps, durationSeconds, exerciseName, movementPattern, suggestedWeightKg, loadCapability, loadKind, progressionPolicy, setTargets, distanceMeters, forceNewtons)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertedPlanId:
SELECT last_insert_rowid();

selectLatestPlan:
SELECT * FROM planHistory ORDER BY id DESC LIMIT 1;

selectAllPlans:
SELECT * FROM planHistory ORDER BY id DESC;

insertDay:
INSERT INTO planHistoryDay(planId, dayIndex, focus) VALUES (?, ?, ?);

selectAllDays:
SELECT * FROM planHistoryDay ORDER BY planId, dayIndex;

insertEntry:
INSERT INTO planHistoryEntry(dayId, position, exerciseId, sets, reps, durationSeconds, exerciseName, movementPattern, suggestedWeightKg, loadCapability, loadKind, progressionPolicy, setTargets, distanceMeters, forceNewtons)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllEntries:
SELECT * FROM planHistoryEntry ORDER BY dayId, position;

setEntrySuperset:
UPDATE planHistoryEntry SET superset = ? WHERE dayId = ? AND position = ?;

selectEntriesForDay:
SELECT * FROM planHistoryEntry WHERE dayId = ? ORDER BY position;

updateEntryExerciseId:
UPDATE planHistoryEntry SET exerciseId = :newId WHERE exerciseId = :oldId;

countEntriesForExercise:
SELECT COUNT(*) FROM planHistoryEntry WHERE exerciseId = ?;

-- Replaces one slot's exercise and its rederived ordered targets in place. The caller supplies null
-- targets when the new exercise cannot carry the old prescription's load kind.
updateEntryExerciseIdAtPosition:
UPDATE planHistoryEntry
SET exerciseId = :newExerciseId, exerciseName = :newExerciseName, suggestedWeightKg = :newWeightKg,
    loadCapability = :newLoadCapability, loadKind = :newLoadKind, setTargets = :setTargets
WHERE position = :position
  AND dayId IN (SELECT id FROM planHistoryDay WHERE planId = :planId AND dayIndex = :dayIndex);

-- Sets one slot's measure in place. The exercise, sets and load kind are untouched; a timed slot
-- stores NULL reps with its seconds, never both and never a zero sentinel. A force slot is load-free,
-- so it clears the numeric load, and ordered per-set targets are rep-based, so any other measure
-- clears them rather than leaving targets the slot no longer performs.
updateEntryMeasureAtPosition:
UPDATE planHistoryEntry
SET reps = :reps, durationSeconds = :durationSeconds, distanceMeters = :distanceMeters, forceNewtons = :forceNewtons,
    suggestedWeightKg = CASE WHEN :forceNewtons IS NOT NULL THEN NULL ELSE suggestedWeightKg END,
    setTargets = CASE WHEN :reps IS NULL THEN NULL ELSE setTargets END
WHERE position = :position
  AND dayId IN (SELECT id FROM planHistoryDay WHERE planId = :planId AND dayIndex = :dayIndex);

deleteEntriesForPlan:
DELETE FROM planHistoryEntry WHERE dayId IN (SELECT id FROM planHistoryDay WHERE planId = ?);

deleteDaysForPlan:
DELETE FROM planHistoryDay WHERE planId = ?;

deletePlan:
DELETE FROM planHistory WHERE id = ?;

deleteAllEntries:
DELETE FROM planHistoryEntry;

deleteAllDays:
DELETE FROM planHistoryDay;

deleteAllPlans:
DELETE FROM planHistory;
