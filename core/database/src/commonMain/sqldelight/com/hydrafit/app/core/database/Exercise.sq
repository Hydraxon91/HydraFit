CREATE TABLE exercise (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    requiredEquipment TEXT NOT NULL,
    movementPattern TEXT NOT NULL,
    isCustom INTEGER NOT NULL DEFAULT 0,
    isUnilateral INTEGER NOT NULL DEFAULT 0,
    loadCapability TEXT NOT NULL DEFAULT 'UNSPECIFIED',
    involvements TEXT
);

selectAll:
SELECT * FROM exercise ORDER BY id;

selectById:
SELECT * FROM exercise WHERE id = ?;

insert:
INSERT INTO exercise(id, name, requiredEquipment, movementPattern, loadCapability)
VALUES (?, ?, ?, ?, ?);

insertIgnore:
INSERT OR IGNORE INTO exercise(id, name, requiredEquipment, movementPattern, loadCapability)
VALUES (?, ?, ?, ?, ?);

insertCustom:
INSERT INTO exercise(id, name, requiredEquipment, movementPattern, isCustom, isUnilateral, loadCapability, involvements)
VALUES (?, ?, ?, ?, 1, ?, ?, ?);

updateCustom:
UPDATE exercise
SET name = ?, requiredEquipment = ?, movementPattern = ?, isUnilateral = ?, loadCapability = ?, involvements = ?
WHERE id = ? AND isCustom = 1;

updateIsUnilateral:
UPDATE exercise SET isUnilateral = ? WHERE id = ?;

updateInvolvements:
UPDATE exercise SET involvements = ? WHERE id = ? AND involvements IS NULL;

deleteById:
DELETE FROM exercise WHERE id = ? AND isCustom = 1;

countSetsForExercise:
SELECT COUNT(*) FROM workoutSet WHERE exerciseId = ?;

updateMovementPattern:
UPDATE exercise SET movementPattern = ? WHERE id = ?;

-- Backfills the curated load capability onto built-in rows on every start; idempotent. Custom rows
-- hold the user's own selection and are excluded, and a user's edit to a built-in lives in
-- `exerciseOverride`, so neither is touched.
updateLoadCapability:
UPDATE exercise SET loadCapability = ? WHERE id = ? AND isCustom = 0;

-- One-time (idempotent) normalization of legacy involvement weights on built-in rows to the
-- CAT-P0 tier scale: 0.6 -> 0.7, 0.4 -> 0.5, 0.2 -> 0.3. Custom rows hold user-authored weights
-- and are excluded; user edits to built-ins live in `exerciseOverride`, and historical snapshots
-- in `workoutSet`, so neither is touched.
normalizeLegacyInvolvementWeights:
UPDATE exercise
SET involvements = REPLACE(REPLACE(REPLACE(involvements, ':0.6', ':0.7'), ':0.4', ':0.5'), ':0.2', ':0.3')
WHERE isCustom = 0 AND involvements IS NOT NULL;

-- One-time (idempotent) repair of built-in rows whose stored involvement string still uses the
-- pre-MUS-P1 broad muscle names (CHEST/BACK/SHOULDERS/CORE). The value is written from the current
-- seed so an upgraded install matches a fresh one; after the first repair no legacy token remains.
-- The anchored LIKE patterns avoid matching the split names (CHEST_UPPER:, UPPER_BACK:, ...), and
-- custom rows, user overrides and historical snapshots are never touched.
repairLegacyInvolvementNames:
UPDATE exercise
SET involvements = ?
WHERE id = ? AND isCustom = 0 AND involvements IS NOT NULL
    AND (
        involvements LIKE 'CHEST:%' OR involvements LIKE '%,CHEST:%'
        OR involvements LIKE 'BACK:%' OR involvements LIKE '%,BACK:%'
        OR involvements LIKE 'SHOULDERS:%' OR involvements LIKE '%,SHOULDERS:%'
        OR involvements LIKE 'CORE:%' OR involvements LIKE '%,CORE:%'
    );
