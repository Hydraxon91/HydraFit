CREATE TABLE exercise (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    requiredEquipment TEXT NOT NULL,
    primaryMuscles TEXT NOT NULL,
    secondaryMuscles TEXT NOT NULL,
    movementPattern TEXT NOT NULL
);

selectAll:
SELECT * FROM exercise ORDER BY id;

insert:
INSERT INTO exercise(id, name, requiredEquipment, primaryMuscles, secondaryMuscles, movementPattern)
VALUES (?, ?, ?, ?, ?, ?);

insertIgnore:
INSERT OR IGNORE INTO exercise(id, name, requiredEquipment, primaryMuscles, secondaryMuscles, movementPattern)
VALUES (?, ?, ?, ?, ?, ?);

updateMovementPattern:
UPDATE exercise SET movementPattern = ? WHERE id = ?;
