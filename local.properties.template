# Copy to local.properties (gitignored) and fill in locally. Never commit real secrets.

# Gemini API Engine
GEMINI_API_KEY=your_google_ai_studio_key_here

# Release signing (only needed for `assembleRelease`/signed builds).
# Each key falls back to an environment variable of the same name, so CI can
# supply them as secrets instead of writing local.properties. If all four are
# absent, release builds are produced unsigned (with a Gradle warning); debug
# builds are unaffected.
RELEASE_KEYSTORE_PATH=/path/to/keystore.jks
RELEASE_KEYSTORE_PASSWORD=changeme
RELEASE_KEY_ALIAS=hydrafit
RELEASE_KEY_PASSWORD=changeme

# CI (`.github/workflows/release.yml`): the keystore is supplied as the
# `RELEASE_KEYSTORE_BASE64` GitHub Actions secret (base64-encoded keystore).
# The workflow decodes it to a temp file and exports `RELEASE_KEYSTORE_PATH`
# for the build, so that path is local-only and never a secret. The
# password/alias values come from the same-named `RELEASE_KEYSTORE_PASSWORD`,
# `RELEASE_KEY_ALIAS`, and `RELEASE_KEY_PASSWORD` secrets.
#
# `GEMINI_API_KEY` is not currently a CI secret: no CI job calls the Gemini
# engine, so CI builds embed an empty key.
