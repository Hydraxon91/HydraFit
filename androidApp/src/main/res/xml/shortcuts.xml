<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher shortcut only opens the Train tab, using the same tab request a notification tap
    sends. It never starts a session or writes anything.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="open_train"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_train_short"
        android:shortcutLongLabel="@string/shortcut_train_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetClass="com.hydrafit.app.MainActivity"
            android:targetPackage="com.hydrafit.app">
            <extra
                android:name="com.hydrafit.app.extra.OPEN_TAB"
                android:value="LOG" />
        </intent>
    </shortcut>
</shortcuts>
